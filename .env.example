# Copy this file to .env and fill in real values. .env is gitignored.

# --- Database ---
# Neon Postgres connection string (see README for how to get this from your
# Neon project dashboard). Must keep sslmode=require - Neon rejects plain
# connections. The `+psycopg` driver suffix selects psycopg3.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<dbname>?sslmode=require

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Phase 2: embeddings + classification ---
# EMBEDDING_PROVIDER / LLM_PROVIDER select which app/llm implementation is
# used. "local" is free and runs in-process (no key needed). "openai"/
# "gemini" need the matching key below and make BILLED API calls - only
# switch these once you've funded the account. Only "local" is implemented
# for EMBEDDING_PROVIDER right now (no OpenAI/Gemini embeddings yet).
EMBEDDING_PROVIDER=local
LLM_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Clustering (Section 7 stage 3). Starting-point defaults, not tuned
# against real data yet - see README's Phase 2 section.
CLUSTERING_TIME_WINDOW_HOURS=48
CLUSTERING_SIMILARITY_THRESHOLD=0.55

# --- Phase 3: admin review UI ---
# Required, no safe default - signs session cookies, so a hardcoded/known
# value would let anyone forge a logged-in admin session. Generate a real
# one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Section 5's staleness SLA in hours - just the "overdue" flag, no
# auto-escalation (still deferred per Section 11).
REVIEW_SLA_HOURS=48

# --- Phase 6: social listening (X + YouTube) ---
# YouTube Data API v3 key - free tier. Leave blank to skip YouTube fetching
# entirely (fails open, same as leaving OPENAI_API_KEY blank).
YOUTUBE_API_KEY=
# X API v2 Bearer Token - official pay-per-use API, real dollars per post
# read once a client has been granted x_access for an entity. Leave blank
# to skip X fetching entirely - nothing else in this app spends money on
# its own, so this is safe to leave unset until you're ready to test it.
X_API_BEARER_TOKEN=
# $/post read, and the warn-ratio fraction of a client's ceiling that
# flags "approaching" on the cost screen - see README §15 for both.
X_COST_PER_POST_USD=0.005
SOCIAL_FETCH_MAX_RESULTS_PER_ENTITY=10
SOCIAL_CEILING_WARN_RATIO=0.8
