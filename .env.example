# Copy this file to .env and fill in real values. .env is gitignored.

# --- Database ---
# Neon Postgres connection string (see README for how to get this from your
# Neon project dashboard). Must keep sslmode=require - Neon rejects plain
# connections. The `+psycopg` driver suffix selects psycopg3.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<dbname>?sslmode=require

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Phase 2 placeholders (NOT used in Phase 1) ---
# These exist now so the config surface doesn't change shape later.
# EMBEDDING_PROVIDER / LLM_PROVIDER select which backend app/llm implements
# in Phase 2: "local" (free, runs on your machine), "openai", or "gemini".
EMBEDDING_PROVIDER=local
LLM_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
